{
  "expo": {
    "name": "Taste Agent",
    "slug": "taste-agent",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.martinstrell.tasteagent",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Taste Agent uses your location to show saved places and new picks near you."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Taste Agent reads photos you choose to find the places in them.",
          "cameraPermission": "Taste Agent uses the camera to read the sign of a place you want to save."
        }
      ]
    ],
    "scheme": "tasteagent",
    "experiments": {
      "typedRoutes": true
    }
  }
}
